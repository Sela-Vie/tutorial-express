# app config
APP_PORT=3100
SESSION_NAME=tutorial-express
NETWORK_NAME=tutorial-express

# docker postgres
DB_HOST=localhost
DB_PORT=3101
DB_PORT_DEFAULT=5432
DB_CONTAINER_NAME=container-postgres
DB_NAME=postgres
DB_USER_NAME=postgres
DB_PASSWORD=postgres

# this is from $PROTOCOL://$USER_NAME:PASSWORD@$IP_ADD:$PORT/$DB_NAME
DATABASE_URL=postgres://postgres:postgres@localhost:3101/postgres

# docker pg admin 
PGA_PORT=3102
PGA_HTTP_PORT=3013
PGA_PORT_DEFAULT=80
PGA_HTTP_PORT_DEFAULT=443
PGA_CONTAINER_NAME=container-pgadmin
PGA_DEFAULT_EMAIL=admin@admin.com
PGA_DEFAULT_PASSWORD=admin